theorem HiddenMonotonicity.TransformerDC.Transformer.dc_decomposition_linear_cost : ∀ {t d o : ℕ}
  (net : Transformer t d o),
  (∀ (x : DoubledInput (Fin t × Fin d)) (i : Fin o), (net.sharedDecompose x).val.get i = net.decompose x i) ∧
    (∀ (x : DoubledInput (Fin t × Fin d)), (net.sharedDecompose x).steps ≤ 200 * SharedRuntime.networkSize net) ∧
      MonotoneOn net.decompose (Ici 0) ∧
        (∀ (i : Fin o), ConvexOn ℝ (Ici 0) fun x => (net.decompose x i).1) ∧
          (∀ (i : Fin o), ConvexOn ℝ (Ici 0) fun x => (net.decompose x i).2) ∧
            (∀ (x : DoubledInput (Fin t × Fin d)), 0 ≤ x → 0 ≤ net.decompose x) ∧
              (∀ (x : DoubledInput (Fin t × Fin d)) (i : Fin o),
                  (net.decompose x i).1 - (net.decompose x i).2 = net.eval (x.1 - x.2) i) ∧
                (∀ (i : Fin o), ConvexOn ℝ univ fun x => (net.rawDecompose x i).1) ∧
                  (∀ (i : Fin o), ConvexOn ℝ univ fun x => (net.rawDecompose x i).2) ∧
                    (∀ (x : Fin t × Fin d → ℝ), 0 ≤ net.rawDecompose x) ∧
                      ∀ (x : Fin t × Fin d → ℝ) (i : Fin o),
                        (net.rawDecompose x i).1 - (net.rawDecompose x i).2 = net.eval x i :=
fun {t d o} net =>
  And.casesOn (Transformer.dc_decomposition net) fun hm right =>
    And.casesOn right fun hp right =>
      And.casesOn right fun hq right =>
        And.casesOn right fun hn he =>
          And.casesOn (Transformer.raw_dc_decomposition net) fun hrp right =>
            And.casesOn right fun hrq right =>
              And.casesOn right fun hrn hre =>
                ⟨Transformer.sharedDecompose_eq net,
                  ⟨Transformer.sharedDecompose_steps_le net, ⟨hm, ⟨hp, ⟨hq, ⟨hn, ⟨he, ⟨hrp, ⟨hrq, ⟨hrn, hre⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
'HiddenMonotonicity.TransformerDC.Transformer.dc_decomposition_linear_cost' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'HiddenMonotonicity.TransformerDC.Transformer.sharedDecompose_eq' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
